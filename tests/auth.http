@endpoint = http://localhost:3000/api/v1/auth

###
# @name registerAuser
POST {{endpoint}}/register HTTP/1.1
Content-Type: application/json
x-api-key: secretKey

{
  "name": "initialTest",
  "email": "initial.test@example.com",
  "password": "secretpassword"
}

###
# @name login
POST {{endpoint}}/login HTTP/1.1
Content-Type: application/json
x-api-key: secretKey

{
  "email": "initial.test@example.com",
  "password": "secretpassword"
}

###
# Run the login request first; this reuses the token it returned
